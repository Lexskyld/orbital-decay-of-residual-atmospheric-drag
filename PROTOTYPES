Calculate g as the altitude of an object is changing:

public class Main {
    public static void main(String[] args) {
        double G = 6.67430e-11;
        double earthMass = 5.972e24;
        double earthRadius = 6371000;
        double altitude = 100000; 

        double velocity = 0;      
        double time = 0;          
        double dt = 0.1;          
        System.out.println("time(s) | altitude(m) | velocity(m/s) | current g(m/s^2)");
        System.out.println("----------------------------------------------");
      
        while (altitude > 0) {
            double r = earthRadius + altitude;
            double a = (G * earthMass) / Math.pow(r, 2);
            velocity = velocity + a * dt;
            altitude = altitude - velocity * dt;
            time += dt;
            
            if (Math.round(time * 10) % 200 == 0) {
                System.out.printf("%.1f    | %.1f  | %.2f     | %.4f\n", time, altitude, velocity, a);
            }
        }
        System.out.println("----------------------------------------------");
        System.out.printf("The object has landed！total time: %.1f s，final velocity: %.2f m/s\n", time, velocity);
    }
}

Calculate g as drag force is included:

public class Main {
    public static void main(String[] args) {
        double G = 6.67430e-11;
        double earthMass = 5.972e24;
        double earthRadius = 6371000;
        
        double rho = 1.225;  
        double Cd = 0.47;   
        double area = 3.14;  
        double mass = 100;   
        
        double altitude = 100000; 
        double velocity = 0;      
        double time = 0;          
        double dt = 0.1;          

        System.out.println("time(s) | altitude(m) | velocity(m/s) | drag force(N)");
        System.out.println("----------------------------------------------");

        while (altitude > 0) {
            double r = earthRadius + altitude;

            double a_gravity = (G * earthMass) / Math.pow(r, 2);

            Fd = 0.5 * rho * v^2 * Cd * A
            double dragForce = 0.5 * rho * Math.pow(velocity, 2) * Cd * area;
            double a_drag = dragForce / mass; 
            
            double a_net = a_gravity - a_drag;

            velocity = velocity + a_net * dt;
            altitude = altitude - velocity * dt;
            time += dt;

            if (Math.round(time * 10) % 1000 == 0) {
                System.out.printf("%.1f    | %.1f    | %.2f        |   %.2f\n", time, altitude, velocity, dragForce);
            }
        }
        System.out.println("----------------------------------------------");
        System.out.printf("The object has landed！Final velocity: %.2f m/s (约 %.0f km/h)\n", velocity, velocity * 3.6);
    }
}


