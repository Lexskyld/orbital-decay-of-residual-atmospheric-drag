public class OrbitalSimulation {


    public static final double G = 6.67430e-11;
    public static final double M_EARTH = 5.972e24;
    public static final double MU = G * M_EARTH;
    public static final double R_EARTH = 6371000.0;

public static class Vector3D {
        public final double x, y, z;

        public Vector3D(double x, double y, double z) {
            this.x = x; this.y = y; this.z = z;
        }

        public double magnitude() {
            return Math.sqrt(x * x + y * y + z * z);
        }

        public Vector3D add(Vector3D v) {
            return new Vector3D(this.x + v.x, this.y + v.y, this.z + v.z);
        }

        public Vector3D scale(double factor) {
            return new Vector3D(this.x * factor, this.y * factor, this.z * factor);
        }

        public Vector3D normalize() {
            double mag = magnitude();
            return mag == 0 ? new Vector3D(0, 0, 0) : this.scale(1.0 / mag);
        }

        public Vector3D negate() {
            return new Vector3D(-this.x, -this.y, -this.z);
        }
    }
        public static class SpacecraftState {
        private final Vector3D position;
        private final Vector3D velocity;
        private final double mass;
        private final double area;
        private final double time;

        public SpacecraftState(Vector3D pos, Vector3D vel, double mass, double area, double time) {
            this.position = pos;
            this.velocity = vel;
            this.mass = mass;
            this.area = area;
            this.time = time;
        }

        public Vector3D getPosition() { return position; }
        public Vector3D getVelocity() { return velocity; }
        public double getMass() { return mass; }
        public double getArea() { return area; }
        public double getTime() { return time; }
        public double getAltitude() { return position.magnitude() - R_EARTH; }
    }
     public interface ForceModel {
        Vector3D calculateAcceleration(Vector3D pos, Vector3D vel, double mass, double area);
    }




