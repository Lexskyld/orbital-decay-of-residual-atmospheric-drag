 public static class J2Perturbation implements ForceModel {
        private static final double J2 = 0.00108263;

        @Override
        public Vector3D calculateAcceleration(Vector3D pos, Vector3D vel, double mass, double area) {
            double r = pos.magnitude();
            double r3 = r * r * r;
            double r5 = r3 * r * r;
            double zSqOverRSq = (pos.z * pos.z) / (r * r);
            
            double commonFactor = 1.5 * J2 * MU * (R_EARTH * R_EARTH) / r5;

            double ax = commonFactor * pos.x * (1.0 - 5.0 * zSqOverRSq);
            double ay = commonFactor * pos.y * (1.0 - 5.0 * zSqOverRSq);
            double az = commonFactor * pos.z * (3.0 - 5.0 * zSqOverRSq);

            return new Vector3D(ax, ay, az);
        }
    }
        public static class AtmosphericDrag implements ForceModel {
        private final double cDrag;

        public AtmosphericDrag(double cDrag) {
            this.cDrag = cDrag;
        }

        @Override
        public Vector3D calculateAcceleration(Vector3D pos, Vector3D vel, double mass, double area) {
            double altitude = pos.magnitude() - R_EARTH;
            double rho = findDensity(altitude);
            double v = vel.magnitude();
            double forceMag = 0.5 * rho * v * v * cDrag * area;
        Vector3D dragDirection = vel.normalize().negate();
        return dragDirection.scale(forceMag / mass);

        private double findDensity(double h) {
            double altKm = h / 1000.0;
            if (altKm > 150) {
                return 2.789e-10 * Math.exp(-(altKm - 200) / 37.5);
            } else {
                return 1.225 * Math.exp(-altKm / 8.5);
            }
        }
    }

